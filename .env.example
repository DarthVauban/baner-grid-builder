NODE_ENV=development
PORT=3000
COMPOSE_PROJECT_NAME=mt-panel-local
APP_IMAGE=ghcr.io/darthvauban/baner-grid-builder:latest
APP_BIND_PORT=3000
POSTGRES_DB=banner_builder
POSTGRES_USER=banner_user
POSTGRES_PASSWORD=change_me_database_password
DATABASE_URL=postgresql://banner_user:change_me@localhost:5432/banner_builder
DATABASE_SSL=false
JWT_SECRET=replace_with_at_least_32_random_characters
MOBILE_TOKEN_PEPPER=
MOBILE_PUSH_ENABLED=false
MOBILE_DEPLOYMENT_ID=mt-workspace-development
MOBILE_ENVIRONMENT=development
MOBILE_DEPLOYMENT_NAME=MT Workspace DEV
MOBILE_PUBLIC_ORIGIN=http://localhost:3000
MOBILE_API_BASE_URL=http://localhost:3000/api
MOBILE_QR_LOGIN_ENABLED=false
MOBILE_MULTI_ACCOUNT_PAIRING_ENABLED=false
MOBILE_QR_LOGIN_TTL_SECONDS=120
MOBILE_QR_CREATE_RATE_LIMIT=20
MOBILE_QR_STATUS_RATE_LIMIT=180
MOBILE_QR_PREVIEW_RATE_LIMIT=30
MOBILE_QR_DECISION_RATE_LIMIT=30
FIREBASE_PROJECT_ID=mt-workspace-4f42c
FIREBASE_SERVICE_ACCOUNT_BASE64=
JWT_EXPIRES_IN=12h
COOKIE_NAME=mt_session
COOKIE_SECURE=false
APP_ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
STOREFRONT_ORIGIN=
CATALOG_MEDIA_DIR=storage/catalog-media
CHROMIUM_EXECUTABLE_PATH=
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# Local Telegram Bot API is opt-in. API ID/hash are managed in the Telegram integration card.
TELEGRAM_LOCAL_MODE=false
TELEGRAM_API_BASE_URL=
TELEGRAM_BACKUP_TEMP_DIR=storage/telegram-backup-transfer
TELEGRAM_LOCAL_FILE_URI_DIR=
TELEGRAM_LOCAL_CREDENTIALS_DIR=storage/telegram-bot-api-config

# Search infrastructure is opt-in until the search module is enabled.
SEARCH_FEATURE_ENABLED=false
OPENSEARCH_VERSION=3.7.0
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_BIND_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_INDEX_PREFIX=mt-search
REDIS_URL=redis://localhost:6379
REDIS_BIND_PORT=6379
SEARCH_WIDGET_ORIGIN=http://localhost:5173
SEARCH_SYNC_INTERVAL_MINUTES=15
SEARCH_ANALYTICS_RAW_RETENTION_DAYS=90
